          "doy_min": "number",
          "green_days": "number",
          "n_cycles": "number",
          "max_green_rate": "number",
          "max_sen_rate": "number",
          "ndvi_auc": "number",
          "ndvi_winter": "number",
          "ndvi_spring": "number",
          "ndvi_summer": "number",
          "ndvi_autumn": "number",
          "ndmi_mean": "number",
          "ndmi_max": "number",
          "ndmi_min": "number",
          "ndmi_peak": "number",
          "b8_peak": "number",
