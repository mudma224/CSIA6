# flaht bladi — environment variable NAMES only (no secrets in the repo).
# Copy to .env.local (git-ignored) for local development.
MODEL_API_BASE_URL=http://127.0.0.1:8001
MODEL_API_TIMEOUT_MS=8000
# Shared bearer token (optional in local dev; RECOMMENDED on Vercel).
# One variable covers both sides: the Next.js BFF sends it as the bearer, and the
# science function (api/science.py) reads the same variable to enforce it.
# Generate one locally: python -c "import secrets; print(secrets.token_hex(32))"
# MODEL_API_TOKEN=
